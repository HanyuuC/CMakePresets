{
    "version": 8,
    "configurePresets": [
        {
            "name": "ndk-build",
            "displayName": "spdlog-1.15.3 Configure preset using android ndk",
            "description": "spdlog build using android ndk, spdlog-1.15.3",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_SDK}/ndk/23.1.7779620/build/cmake/android.toolchain.cmake",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_MAKE_PROGRAM": "$env{ANDROID_SDK}/cmake/4.1.0/bin/ninja.exe",
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-26",
                "ANDROID_STL": "c++_shared"
            }
        },
        {
            "name": "msvc-build",
            "displayName": "Visual Studio Community 2022 Release - amd64",
            "description": "Using compilers for Visual Studio 17 2022 (x64 architecture)",
            "generator": "Visual Studio 17 2022",
            "toolset": "host=x64",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "msvc-build-debug",
            "displayName": "msvc-build-debug",
            "configurePreset": "msvc-build",
            "configuration": "Debug"
        },
        {
            "name": "msvc-build-release",
            "displayName": "msvc-build-release",
            "configurePreset": "msvc-build",
            "configuration": "Release"
        }
    ]
}